{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "outDir": "web/static/js",
    "rootDir": "web/static/ts",
    "declaration": false,
    "sourceMap": false,
    "lib": ["ES2020", "DOM"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["web/static/ts/**/*.ts"],
  "exclude": ["node_modules"]
}
